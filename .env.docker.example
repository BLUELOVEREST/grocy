# Image built by .gitea/workflows/release-image.yml
ERIC_GROCY_IMAGE=192.168.200.101:54453/zhangzhicheng/eric-grocy
ERIC_GROCY_VERSION=v4.6.0-eric.1

# Host port mapped to container port 80
ERIC_GROCY_PORT=9284

# Persistent Grocy data directory on the host
ERIC_GROCY_DATA_PATH=./data

# Grocy runtime settings
GROCY_BASE_URL=/
GROCY_MODE=production
GROCY_DEFAULT_LOCALE=zh_CN
GROCY_CURRENCY=CNY
GROCY_DISABLE_AUTH=false
TZ=Asia/Shanghai
